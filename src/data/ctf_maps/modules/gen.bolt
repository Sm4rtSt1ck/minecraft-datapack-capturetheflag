# Functions generated from the maps registry (registry/maps.bolt) at build time
from registry:maps import MAPS, EVENTS
from admin:bot_markers import SPOTS, ROUTE_COLORS, ROUTE_TEXT, summon_marker

# The map clone, as a bot marker of the template positioned at its place in the arena: its copy is
# a marker (a map entity: killed at the next clone) with the arena tag of its kind (BOTS.md);
# a route point keeps its number (bot.idx)
function ctf_maps:internal/bots/copy:
    for _sp in SPOTS:
        execute if entity @s[tag=f"{_sp['tag']}"] run summon marker ~ ~ ~ {Tags: ["map_entity", "bot_spot", "bot_nav", (_sp["arena"])]}
    for _r in range(1, 5):
        execute if entity @s[tag=f"build_route_{_r}"] run summon marker ~ ~ ~ {Tags: ["map_entity", "bot_route", "bot_nav", (f"bot_route_{_r}"), "bot_new"]}
        execute if entity @s[tag=f"build_route_{_r}"] run scoreboard players set @n[type=marker, tag=bot_new] bot.r (_r)
    execute if entity @s[tag=build_route] run scoreboard players operation @n[type=marker, tag=bot_new] bot.idx = @s build.idx
    tag @e[type=marker, tag=bot_new] remove bot_new

# Runs ctf_maps:map/<the map of the vote>/<event> (number of the map = result map_vote)
for e in EVENTS:
    function f"ctf_maps:api/call/{e}":
        for i in range(len(MAPS)):
            execute if score result map_vote matches (i + 1) run function f"ctf_maps:map/{MAPS[i]['id']}/{e}"


# The functions of every map (registry MAPS): all maps work the same way
from registry:world import ARENA
from ctf_maps:lib import in_arena, copy_solid, copy_bot_markers, template_block, fill_area, fill_replace, spawn, spawn_bots, template_marker, win_trigger, loot_points

for _src in MAPS:
    # The coordinates of the registry are in the template: moved into the arena here
    _m = in_arena(_src)
    _id = _m["id"]
    _a = _m["areas"]
    _p = _m["points"]

    # Match start (as the starting player): the title, the music loop, the daylight
    function f"ctf_maps:map/{_id}/start":
        title @s title (_m["title"])
        if _m["music"]:
            execute if score Music settings matches 1 run schedule function f"ctf_maps:map/{_id}/music" 200t
        if "time" in _m:
            gamerule doDaylightCycle true
            time set (_m["time"])

    # The music loop (stopped by ctf_maps:on/match_start)
    function f"ctf_maps:map/{_id}/music":
        if _m["music"]:
            _mu = _m["music"]
            execute if score game state matches 2..6 run playsound (_mu["disc"]) master @a[tag=!lobby] (ARENA["music"][0]) (ARENA["music"][1]) (ARENA["music"][2]) 70 (_mu["pitch"])
            execute if score game state matches 2..6 run schedule function f"ctf_maps:map/{_id}/music" (_mu["period"])

    # The template is found by its marker (ctf_maps:internal/prepare)
    function f"ctf_maps:map/{_id}/prepare":
        function admin:log/function {name: (f"match/maps/{_id}/prepare")}
        template_marker(_m)
        if "prepare_fills" in _m:
            for _f in _m["prepare_fills"]:
                fill_replace(_a[_f["area"]], _f["block"], _f["replaces"])

    # After the template is cloned into the arena
    function f"ctf_maps:map/{_id}/clone":
        function admin:log/function {name: (f"match/maps/{_id}/clone")}
        if "entities" in _m:
            for _e in _m["entities"]:
                summon (_e[0]) (_p[_e[1]][0]) (_p[_e[1]][1]) (_p[_e[1]][2]) (_e[2])
        win_trigger(_m)
        copy_solid(_src)
        copy_bot_markers(_src)

    # Start of freeze (as every player): the borders are closed, the player goes to his spawn
    function f"ctf_maps:map/{_id}/freeze":
        function admin:log/function {name: (f"match/maps/{_id}/freeze")}
        for _w in _m["walls"]:
            _block = _m["wall_block"]
            if "block" in _w:
                _block = _w["block"]
            _what = "air"
            if "replaces" in _w:
                _what = _w["replaces"]
            fill_replace(_a[_w["area"]], _block, _what)
        spawn(_m, "attack")
        spawn(_m, "defense")

    # Start of the round: the borders are opened
    function f"ctf_maps:map/{_id}/round":
        function admin:log/function {name: (f"match/maps/{_id}/round")}
        for _w in _m["walls"]:
            _open = "replace"
            if "open" in _w:
                _open = _w["open"]
            if _open is None:
                continue
            _area = _a[_w["area"]]
            if "open_area" in _w:
                _area = _a[_w["open_area"]]
            if _open == "all":
                fill_area(_area, "minecraft:air")
            else:
                _block = _m["wall_block"]
                if "block" in _w:
                    _block = _w["block"]
                fill_replace(_area, "minecraft:air", _block)
            if "fx" in _w:
                _at = _p[_w["fx"]["at"]]
                for _pa in _w["fx"]["particles"]:
                    particle (_pa[0]) (_at[0]) (_at[1]) (_at[2]) (_pa[1][0]) (_pa[1][1]) (_pa[1][2]) (_pa[2]) (_pa[3]) normal
                _so = _p[_w["fx"]["sound_at"]]
                playsound block.end_gateway.spawn block @a (_so[0]) (_so[1]) (_so[2]) 1

    function f"ctf_maps:map/{_id}/end_round":
        pass

    # The bots of both sides go to their spawns (ctf_bots:on/freeze_start)
    function f"ctf_maps:map/{_id}/spawn_bots":
        spawn_bots(_m, "attack")
        spawn_bots(_m, "defense")

    # Loot crate landing points (ctf_loot:freeze_start)
    function f"ctf_maps:map/{_id}/loot":
        loot_points(_m)

    # The bot annotation of the registry as markers on the template, to edit it (admin:build/bots)
    function f"admin:build/bots/show/{_id}":
        execute unless score game state = lobby state run return run function admin:build/internal/wrong_phase
        if "bot" in _src:
            _bs = _src["bot"]
            for _sp in SPOTS:
                if _sp["key"] in _bs:
                    for _pt in _bs[_sp["key"]]:
                        summon_marker(_sp["tag"], _sp["label"], _sp["color"], _sp["text"], _pt)
            if "routes" in _bs:
                for _ri in range(len(_bs["routes"])):
                    for _pt in _bs["routes"][_ri]:
                        summon_marker(f"build_route_{_ri + 1}", f"R{_ri + 1}", ROUTE_COLORS[_ri], ROUTE_TEXT[_ri], _pt)
                        execute as @e[type=armor_stand, tag=build_new] run tag @s add build_route
                        execute as @e[type=armor_stand, tag=build_new] run function admin:build/bots/internal/route_index
                        tag @e[type=armor_stand, tag=build_new] remove build_new
        tag @e[type=armor_stand, tag=build_new] remove build_new
        function admin:build/bots/internal/glow_reset
        tellraw @s {"text": "The bot markers of the registry are shown (admin:build/bots/dump to save them)", "color": "green"}

    # Admin teleport to the template of the map (admin:tp/tp: creative, out of the lobby)
    function f"admin:tp/{_id}":
        if "admin_tp" in _src:
            _at = _src["admin_tp"]
        else:
            _tb = template_block(_src)
            _at = [_tb[0] + ARENA["size"][0] // 2, _tb[1] + ARENA["size"][1], _tb[2] + ARENA["size"][2] // 2]
        function admin:tp/tp {xyz: (f"{_at[0]} {_at[1]} {_at[2]}")}
