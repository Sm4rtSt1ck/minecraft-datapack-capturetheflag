# Build-time helpers for the map functions (bolt): the coordinates come from registry/maps.bolt.
# They write commands into the calling function.
from registry:world import ARENA

# floor() of a coordinate (the block of a position)
def _floor(v):
    _f = int(v)
    if _f > v:
        _f = _f - 1
    return _f

# The block of the template corner and the shift template -> arena (ctf_maps:internal/prepare/clone
# copies the template from this block to ARENA["corner"])
def template_block(map):
    _b = []
    for _i in range(3):
        _b.append(_floor(map["template"][_i]))
    return _b

def arena_shift(map):
    _b = template_block(map)
    _d = []
    for _i in range(3):
        _d.append(ARENA["corner"][_i] - _b[_i])
    return _d

# A point moved by d
def _move(point, d):
    return [point[0] + d[0], point[1] + d[1], point[2] + d[2]]

# A map entry with its coordinates moved from the template into the arena: the registry gives them
# in the world coordinates of the template, the block of the template corner goes to ARENA corner
# (ctf_maps:internal/prepare/clone). Used by ctf_maps:gen for every map.
def in_arena(map):
    _d = arena_shift(map)
    _out = {}
    for _k in map:
        _out[_k] = map[_k]
    _out["areas"] = {}
    for _k in map["areas"]:
        _ar = map["areas"][_k]
        _moved = []
        for _i in range(6):
            _moved.append(_ar[_i] + _d[_i % 3])
        _out["areas"][_k] = _moved
    _out["points"] = {}
    for _k in map["points"]:
        _out["points"][_k] = _move(map["points"][_k], _d)
    _out["win_trigger"] = _move(map["win_trigger"], _d)
    _out["spawns"] = {}
    for _side in map["spawns"]:
        _s = map["spawns"][_side]
        _out["spawns"][_side] = {"center": [_s["center"][0] + _d[0], _s["center"][1] + _d[2]], "under": _s["under"] + _d[1], "spread": _s["spread"], "range": _s["range"]}
    _out["loot"] = []
    for _pt in map["loot"]:
        _out["loot"].append(_move(_pt, _d))
    return _out

# fill <area> <block>
def fill_area(area, block):
    fill (area[0]) (area[1]) (area[2]) (area[3]) (area[4]) (area[5]) (block)

# fill <area> <block> replace <what>
def fill_replace(area, block, what):
    fill (area[0]) (area[1]) (area[2]) (area[3]) (area[4]) (area[5]) (block) replace (what)

# The executing player of the side is spread around the side's spawn of the map
def spawn(map, side):
    _s = map["spawns"][side]
    spreadplayers (_s["center"][0]) (_s["center"][1]) (_s["spread"]) (_s["range"]) under (_s["under"]) false @s[tag=f"{side}"]

# The bots of the side are spread around the side's spawn of the map (ctf_bots, BOTS.md)
def spawn_bots(map, side):
    _s = map["spawns"][side]
    spreadplayers (_s["center"][0]) (_s["center"][1]) (_s["spread"]) (_s["range"]) under (_s["under"]) false @e[type=husk, tag=ctf_bot, tag=f"{side}"]

# The map template marker (its chunk is force loaded): ctf_maps:map/<id>/prepare
def template_marker(map):
    _t = map["template"]
    forceload add (int(_t[0])) (int(_t[2]))
    summon armor_stand (_t[0]) (_t[1]) (_t[2]) {Marker:true, Tags:["clone_marker"]}

# The unbreakable blocks of the template (admin:build/solid) are copied into the arena: their
# displays stand on block corners; a selector box from the corner - 0.5 catches the displays of
# x..x+127 (a display has no size: one on the box border would not be selected)
def copy_solid(map):
    _b = template_block(map)
    _d = arena_shift(map)
    execute positioned (_b[0] - 0.5) (_b[1] - 0.5) (_b[2] - 0.5) as @e[type=block_display, tag=ctf_solid, dx=(ARENA["size"][0] - 1), dy=(ARENA["size"][1] - 1), dz=(ARENA["size"][2] - 1)] at @s positioned f"~{_d[0]}" f"~{_d[1]}" f"~{_d[2]}" run function ctf_maps:internal/solid/copy

# The bot markers of the template (admin:build/bots, BOTS.md) are copied into the arena as markers
# (ctf_maps:internal/bots/copy): the bots' knowledge of the map. Like copy_solid
def copy_bot_markers(map):
    _b = template_block(map)
    _d = arena_shift(map)
    execute positioned (_b[0] - 0.5) (_b[1] - 0.5) (_b[2] - 0.5) as @e[type=armor_stand, tag=build_bot, dx=(ARENA["size"][0] - 1), dy=(ARENA["size"][1] - 1), dz=(ARENA["size"][2] - 1)] at @s positioned f"~{_d[0]}" f"~{_d[1]}" f"~{_d[2]}" run function ctf_maps:internal/bots/copy

# The flag is delivered here: ctf_maps:map/<id>/clone
def win_trigger(map):
    _w = map["win_trigger"]
    summon minecraft:armor_stand (_w[0]) (_w[1]) (_w[2]) {Marker: true, Invisible: true, Tags: ["win_trigger"]}

# Loot crate landing points: ctf_maps:map/<id>/loot
def loot_points(map):
    for _pt in map["loot"]:
        function ctf_loot:point {x: (_pt[0]), y: (_pt[1]), z: (_pt[2])}
