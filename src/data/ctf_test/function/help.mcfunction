tellraw @s [{"text": "/function ctf_test:loot/drop_here {rarity: \"rare\"}", "color": "yellow", "clickEvent": {"action": "suggest_command", "value": "/function ctf_test:loot/drop_here {rarity: \"rare\"}"}}, {"text": " - your crate onto the block you stand in", "color": "gray"}]
tellraw @s [{"text": "/function ctf_test:loot/task {id: \"fist\"}", "color": "yellow", "clickEvent": {"action": "suggest_command", "value": "/function ctf_test:loot/task {id: \"fist\"}"}}, {"text": " - count a task as done (flag_bring / flag_break / enemy_trap / fist / kills / wind)", "color": "gray"}]
