tellraw @s [{"text": "/function ctf_test:loot/creep", "color": "yellow", "clickEvent": {"action": "suggest_command", "value": "/function ctf_test:loot/creep"}}, {"text": " - turn yourself into a Creepenator creeper", "color": "gray"}]
