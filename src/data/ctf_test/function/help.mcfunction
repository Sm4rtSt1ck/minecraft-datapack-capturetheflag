# List of the manual tests (click a line to put the command into the chat)
tellraw @s {"text": "=== CTF TESTS ===", "color": "gold", "bold": true}
tellraw @s [{"text": "/function ctf_test:fx/shake", "color": "yellow", "clickEvent": {"action": "suggest_command", "value": "/function ctf_test:fx/shake"}}, {"text": " - camera shake for you", "color": "gray"}]
