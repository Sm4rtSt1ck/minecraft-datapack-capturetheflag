tellraw @s [{"text": "/function ctf_test:loot/clear", "color": "yellow", "clickEvent": {"action": "suggest_command", "value": "/function ctf_test:loot/clear"}}, {"text": " - remove all crates with the explosion", "color": "gray"}]
