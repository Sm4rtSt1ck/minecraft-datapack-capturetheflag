# As a player: what the bots learned on the map being played (BOTS.md stage 11), in detail
# (ctf_bots:internal/learn/stats; a count = one event: a player seen there for 2 s, a death...); the
# points within 16 of him shown (end rods)
execute unless score Bots_learn settings matches 1 run tellraw @s {"text": "Bot learning is OFF (/function ctf_test:bots/learn)", "color": "red"}
execute unless score #map lrn matches 1.. run return run tellraw @s {"text": "No map loaded for learning: run it during a match (learning on at the map clone)", "color": "yellow"}
function ctf_bots:internal/learn/save
function ctf_bots:internal/learn/stats
execute store result score #c3 lrn run data get storage ctf_bots:learn buy
execute store result score #c4 lrn run data get storage ctf_bots:learn buyb
scoreboard players operation #age lrn = #lt lrn
scoreboard players operation #age lrn -= #saved lrn
tellraw @s {"text": "=== What the bots learned on this map ===", "color": "gold"}
tellraw @s [{"text": "Places: ", "color": "yellow"}, {"score": {"name": "#S_pts", "objective": "lrn"}, "color": "white"}, {"text": " (", "color": "gray"}, {"score": {"name": "#S_new", "objective": "lrn"}, "color": "white"}, {"text": " from players' trails, the rest your markers)", "color": "gray"}]
tellraw @s [{"text": "Seen there: ", "color": "yellow"}, {"text": "attackers ", "color": "gray"}, {"score": {"name": "#S_ha", "objective": "lrn"}, "color": "red"}, {"text": ", defenders ", "color": "gray"}, {"score": {"name": "#S_hd", "objective": "lrn"}, "color": "blue"}, {"text": ", flag carriers ", "color": "gray"}, {"score": {"name": "#S_hc", "objective": "lrn"}, "color": "light_purple"}, {"text": " (x2 s)", "color": "dark_gray"}]
tellraw @s [{"text": "Events: ", "color": "yellow"}, {"text": "deaths ", "color": "gray"}, {"score": {"name": "#S_dg", "objective": "lrn"}, "color": "white"}, {"text": ", grenades ", "color": "gray"}, {"score": {"name": "#S_nd", "objective": "lrn"}, "color": "white"}, {"text": ", flags hidden by players ", "color": "gray"}, {"score": {"name": "#S_hide", "objective": "lrn"}, "color": "white"}]
tellraw @s [{"text": "Players' traps: ", "color": "yellow"}, {"text": "TNT ", "color": "gray"}, {"score": {"name": "#S_t_tnt", "objective": "lrn"}, "color": "white"}, {"text": ", anvil ", "color": "gray"}, {"score": {"name": "#S_t_anvil", "objective": "lrn"}, "color": "white"}, {"text": ", web ", "color": "gray"}, {"score": {"name": "#S_t_web", "objective": "lrn"}, "color": "white"}, {"text": ", levitation ", "color": "gray"}, {"score": {"name": "#S_t_levitation", "objective": "lrn"}, "color": "white"}, {"text": ", wither ", "color": "gray"}, {"score": {"name": "#S_t_wither", "objective": "lrn"}, "color": "white"}]
tellraw @s [{"text": "Ways: ", "color": "yellow"}, {"score": {"name": "#S_lk", "objective": "lrn"}, "color": "white"}, {"text": " (", "color": "gray"}, {"score": {"name": "#S_obs", "objective": "lrn"}, "color": "white"}, {"text": " shown by players, ", "color": "gray"}, {"score": {"name": "#S_n", "objective": "lrn"}, "color": "white"}, {"text": " times); bots passed ", "color": "gray"}, {"score": {"name": "#S_s", "objective": "lrn"}, "color": "green"}, {"text": ", failed ", "color": "gray"}, {"score": {"name": "#S_f", "objective": "lrn"}, "color": "red"}]
tellraw @s [{"text": "Players' wind charges: ", "color": "yellow"}, {"score": {"name": "#S_ws", "objective": "lrn"}, "color": "white"}, {"text": " (", "color": "gray"}, {"score": {"name": "#S_wf", "objective": "lrn"}, "color": "white"}, {"text": " in fights)", "color": "gray"}]
tellraw @s [{"text": "Bots' own results: ", "color": "yellow"}, {"text": "flag held ", "color": "gray"}, {"score": {"name": "#S_hw", "objective": "lrn"}, "color": "green"}, {"text": " / lost ", "color": "gray"}, {"score": {"name": "#S_hl", "objective": "lrn"}, "color": "red"}, {"text": " rounds; traps that worked ", "color": "gray"}, {"score": {"name": "#S_tw", "objective": "lrn"}, "color": "white"}, {"text": "; kills from their places ", "color": "gray"}, {"score": {"name": "#S_dk", "objective": "lrn"}, "color": "white"}, {"text": "; grenade hits ", "color": "gray"}, {"score": {"name": "#S_nh", "objective": "lrn"}, "color": "white"}]
function ctf_bots:internal/learn/stat_routes
tellraw @s [{"text": "Forgetting: ", "color": "yellow"}, {"text": "old counts x ", "color": "gray"}, {"score": {"name": "Bots_decay", "objective": "settings"}, "color": "white"}, {"text": "% once a match, at the start of the game (/function ctf_test:bots/learn_decay {pct: N})", "color": "gray"}]
tellraw @s [{"text": "Purchases: ", "color": "yellow"}, {"score": {"name": "#c3", "objective": "lrn"}, "color": "white"}, {"text": " situations from players, ", "color": "gray"}, {"score": {"name": "#c4", "objective": "lrn"}, "color": "white"}, {"text": " with the bots' own results (all maps); last save ", "color": "gray"}, {"score": {"name": "#age", "objective": "lrn"}, "color": "white"}, {"text": " ticks ago", "color": "gray"}]
execute at @s as @e[type=marker, tag=lrn_pt, distance=..16] at @s run particle minecraft:end_rod ~ ~0.5 ~ 0 0.5 0 0 10 force @a
