# SHOP REGISTRY. Read at build time by bolt (ctf_shop:gen and the product functions):
# the pages, their products, the purchase limits per round.
#
# A page is a category of the shop: shop_category = its number in PAGES (1, 2, ...).
#   button - the category button in the menu row (slots 9-17)
# A product is a shop slot (18-35) of the page:
#   cost - the price shown in the shop and passed to the purchase
#   look - the display item (ctf_shop:ui/product): model, name (JSON text), extra components
#   looks - instead of look: one look per team, the same slot (the purchase checks the team itself)
#   team - only this team sees and buys it
#   glint_ult - the ultimate of this number glints while it is selected
#   buy - (function, arguments) run on a click; COST / NAME in the arguments are replaced by the
#         cost / the look name. Without arguments the function reads its data here by the id
#         (ctf_shop:product/<id>: product(id)).
from registry:items import limit
from registry:traps import trap
from registry:ultimates import ult, ult_num


COST = "<cost>"
NAME = "<name>"
GLINT = "enchantment_glint_override=true"
WIND = limit("wind")["max"]


def look(model, name, extra=""):
    return {"model": model, "name": name, "extra": extra}


def group_buy(item, group, components, wpn):
    return ("ctf_shop:buy/group", {"item": item, "wpn": wpn, "name": NAME, "components": components, "count": 1, "cost": COST, "group": group, "bind": "1b", "offhand": 0, "free": 0})


# Defense traps (registry:traps): a frog spawn egg that places an armor stand with the trap block on
# its head (the trap items are found by their entity_data Tags, ctf_shop:on/freeze_start)
def trap_buy(id, title, count):
    block = trap(id)["block"]
    components = f'custom_data={{tags:[""]}}, item_model={block}, entity_data={{id:"minecraft:armor_stand", Marker:true, Invisible:true, Tags:["trap", "trap_display", "trap.{id}"], ArmorItems:[{{}}, {{}}, {{}}, {{id:"minecraft:{block}"}}]}}'
    return ("ctf_shop:buy/unique", {"key": f"{id}_trap", "title": title, "item": "frog_spawn_egg", "name": NAME, "count": count, "cost": COST, "components": components})


# Ultimates (registry:ultimates): the shop item looks like the ultimate item
def ult_look(id):
    u = ult(id)
    return look(u["model"], '{"text": "' + u["name"] + '"}')


def bow_buy(wpn, enchantments):
    return ("ctf_shop:product/bow", {"wpn": wpn, "cost": COST, "name": NAME, "enchantments": enchantments})


def cost_buy(fn, more=None):
    args = {"cost": COST}
    if more:
        for k in more:
            args[k] = more[k]
    return (fn, args)


