# Purchase limits per round (ctf_shop:limits/<id>): id of a carry limit (registry:items LIMITS,
# its predicate and max), the name in the message. The count starts with what the player carries
# at the start of freeze (ctf_shop:limits/reset).
ROUND_LIMITS = [
    {"id": "he", "name": "grenade"},
    {"id": "totem", "name": "totem of undying"},
    {"id": "shield", "name": "shield"},
    {"id": "regen", "name": "regeneration potion"},
    {"id": "speed", "name": "speed potion"},
    {"id": "chorus", "name": "chorus fruits"},
    {"id": "smoke", "name": "smoke grenade"},
]


def product(id):
    for page in PAGES:
        for p in page["products"]:
            if p["id"] == id:
                return p
