        "name": "RARE",
        "box": "blue_shulker_box",
        "from_color": [0.05, 0.12, 0.4],
        "color": [0.15, 0.35, 1.0],
        "text_color": "blue",
        "reward": "blue_wool"
    },
    {
        "id": "epic",
        "name": "EPIC",
        "box": "purple_shulker_box",
        "from_color": [0.22, 0.03, 0.35],
        "color": [0.6, 0.1, 0.9],
        "text_color": "dark_purple",
        "reward": "purple_wool"
    },
    {
