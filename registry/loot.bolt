        "box": "red_shulker_box",
        "from_color": [0.2, 0.0, 0.01],
        "color": [0.55, 0.0, 0.03],
        "text_color": "dark_red",
        "reward": "red_wool"
    },
]


# TASKS: the rarity of the crate, chat text (no quotes) and the reward: a function
# ctf_loot:reward/<reward>. A task without "reward" gives the test item of its rarity.
# A task is completed by ctf_loot:task {id: "<id>"} (only the tasks listed here count).
TASKS = [
    {
        "id": "flag_bring",
        "rarity": "common",
        "text": "Deliver the flag",
        "reward": "stun"
    },
    {
        "id": "unkillable",
        "rarity": "rare",
        "text": "Take more than 20 damage in one round and stay alive",
        "reward": "walls"
    },
    {
        "id": "kills_total",
        "rarity": "epic",
        "text": "Kill 10 enemies in this match",
        "reward": "inferno"
    },
    {
        "id": "enemy_trap",
        "rarity": "epic",
        "text": "Kill an enemy with their own trap",
        "reward": "creep"
    },
    # {"id": "flag_break", "rarity": "rare", "text": "Break the flag"},
    # {"id": "fist", "rarity": "legendary", "text": "Kill an enemy with bare hands"},
    # {"id": "kills", "rarity": "mythic", "text": "Kill 5 enemies in one round"},
    # {"id": "wind", "rarity": "mythic", "text": "Kill an enemy with a flying wind charge"},
]


# The "kills" task: how many kills in one round, and the minimum number of enemies in the match
KILLS = {"count": 5, "min_enemies": 5}
# The "unkillable" task: damage taken in one round (tenths of HP: 200 = 20 HP) - more than that
UNKILLABLE = {"damage": 200}
# The "kills_total" task: kills in the whole match
KILLS_TOTAL = {"count": 10}


def rank(rarity):
    for i in range(len(RARITIES)):
        if RARITIES[i]["id"] == rarity:
            return i + 1
